{
  "name": "@cards/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/worker.ts",
  "types": "src/worker.ts",
  "exports": {
    ".": "./src/worker.ts",
    "./protocol": "./src/protocol.ts",
    "./room": "./src/room.ts",
    "./hub": "./src/hub.ts",
    "./view": "./src/view.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --local",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cards/engine": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9",
    "wrangler": "^4.124.0"
  }
}
